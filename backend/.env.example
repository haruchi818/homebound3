BIND_ADDR=127.0.0.1:8080
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=none
GOOGLE_CLIENT_SECRET=none
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
SESSION_KEY=replace-with-64-byte-minimum-secret
SESSION_SECURE=false
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/homebound
MEDIA_ORIGINALS_PATH=/var/media/originals
MEDIA_HLS_PATH=/var/media/hls
MEDIA_THUMBNAILS_PATH=/var/media/thumbnails
MEDIA_SUBTITLES_PATH=/var/media/subtitles
MEDIA_UPLOAD_TMP_PATH=/var/media/uploads
MAX_UPLOAD_GB=10
ALLOWED_VIDEO_FORMATS=mp4,mkv,avi,mov,webm
FFMPEG_PATH=/usr/bin/ffmpeg
